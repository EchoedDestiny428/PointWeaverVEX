{
  "name": "pointweaver-vex",
  "productName": "PointWeaver",
  "version": "0.5.0",
  "private": true,
  "description": "VEX path editor: build autons out of reusable paths and get the LemLib code.",
  "author": "Crimson",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "app": "npm run build && npm run build:electron && electron .",
    "app:dev": "npm run build:electron && electron . --dev",
    "dist": "npm run build && npm run build:electron && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "build:cli": "tsc -p tsconfig.cli.json && node scripts/esm-fix.mjs dist-cli",
    "analyze": "npm run build:cli && node dist-cli/scripts/analyze.js",
    "sample": "npm run build:cli && node dist-cli/scripts/make-sample.js"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "org.pointweaver.vex",
    "productName": "PointWeaver",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PointWeaver-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PointWeaver-${version}-portable.exe"
    }
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
